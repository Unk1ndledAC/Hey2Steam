# Hey2Steam configuration — copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file. All values below are placeholders.

# --- HeyBox (xiaohiehe / HeyBox) ---
# Your HeyBox user ID (the numeric ID shown in your HeyBox profile / API requests).
HEYBOX_ID=
# Optional: a device identifier (imei / device_id) used by the HeyBox API.
# Leave empty to auto-generate a random one per run.
HEYBOX_IMEI=
# Optional: HeyBox login credential (pkey) — only needed for private wishlists.
HEYBOX_PKEY=
# Signature algorithm variant: "web" (current website) or "chat" (older client).
HEYBOX_SIGN_ALGO=web

# --- Steam ---
# Your 64-bit Steam ID (e.g. 7656119xxxxxxxxxx).
STEAM_ID=
# Steam Web API key (https://steamcommunity.com/dev/apikey) — for reading data.
STEAM_API_KEY=
# User access token (webapi_token) — REQUIRED to write to the wishlist.
# Get it: log into Steam, open
#   https://store.steampowered.com/pointssummary/ajaxgetasyncconfig
# and copy the "webapi_token" value. It expires roughly every 24 hours.
STEAM_ACCESS_TOKEN=
# Optional legacy fallback: a store sessionid for the old addtowishlist endpoint.
STEAM_SESSIONID=
